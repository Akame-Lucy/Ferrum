[Unit]
Description=Ferrous agent
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ferrous-agent --config /etc/ferrous/ferrous.yaml
Restart=on-failure
RestartSec=5

# Runs as a dedicated, unprivileged, non-login system user. Create it once:
#   useradd --system --no-create-home --shell /usr/sbin/nologin ferrous
# and make sure it owns /etc/ferrous (identity key, ferrous.yaml) and every
# path listed under clients[].allowed_paths in ferrous.yaml.
User=ferrous
Group=ferrous

# --- Sandboxing ---
# ProtectSystem=strict makes the whole filesystem read-only to this process
# except what's explicitly listed below. Add every path your clients are
# actually granted in ferrous.yaml's allowed_paths, or file operations there
# will fail even though the capability check passes.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/ferrous /srv/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Deliberately NOT setting MemoryDenyWriteExecute=yes here: the agent spawns
# real interactive shells for clients with allow_shell, and seccomp filters
# survive exec, so this would also constrain whatever the client runs inside
# that shell (breaking JIT-based tools, some REPLs, etc). If shell access is
# disabled for every client you authorize, uncomment it:
# MemoryDenyWriteExecute=yes

# Uncomment only if you need to bind a port below 1024 directly (the default
# 9090 doesn't need this):
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
